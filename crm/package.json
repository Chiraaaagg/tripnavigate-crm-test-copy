{
  "name": "tripnavigate-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TripNavigate internal CRM (Holiday Chacha Pvt LTD) - Batch 1 secure staff foundation",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/check-local-dev.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:supabase": "vitest run --project supabase",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --project=screenshots",
    "check": "npm run typecheck && npm run lint && npm run test",
    "local:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-up.ps1",
    "local:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-down.ps1",
    "bitrix:setup": "node scripts/local-bitrix-setup.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "get-nonce": "1.0.1",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "playwright-core": "1.63.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "supabase": "^2.119.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
