# TripNavigate CRM environment variables. Copy to .env.local for local work.
# NEVER commit real values. Staging/production values live in Vercel and
# Supabase project settings, owned by company accounts.

# local | staging | production. Vercel Preview MUST be staging.
APP_ENV=local

# Public (sent to the browser). Publishable key only; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# SERVER ONLY. Secret (service-role) key; bypasses RLS. Never prefix with
# NEXT_PUBLIC_, never log, never expose to Preview deployments of production.
SUPABASE_SECRET_KEY=

# Production project ref (not secret). Set in every Vercel environment so that
# non-production builds refuse to start if they point at production.
PRODUCTION_SUPABASE_PROJECT_REF=

# Comma-separated domains staff invitations may be sent to.
# Non-production default: example.test (reserved, undeliverable).
# Production: the company staff domain only (not yet supplied, D17a).
STAFF_INVITE_ALLOWED_DOMAINS=

# The absolute session lifetime is NOT an environment variable. It lives in
# the database (public.security_policy, PROPOSED 12 h) and is enforced there.

# Local only: enables /preview/<state> design-review gallery in `next dev`.
ENABLE_UI_PREVIEW=false

# Local/CI only: password for synthetic fixture users created by
# scripts/seed-local.mjs. Choose your own; 12+ characters.
LOCAL_FIXTURE_PASSWORD=

# Local/CI only: set to 1 to make real-stack test suites FAIL (not skip) when
# the variables below are missing. CI sets it in every real-stack job.
REQUIRE_REAL_STACK=
# Real-stack tests and scripts (values from `supabase status -o env`).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Local Mailpit (email capture) used by real-stack tests.
MAILPIT_URL=http://127.0.0.1:54324

# scripts/bootstrap-first-admin.mjs (first administrator; see the script).
# Who is running the bootstrap (name or ticket), recorded in the audit event.
BOOTSTRAP_OPERATOR=
# Base URL for the invitation link (defaults to NEXT_PUBLIC_SITE_URL).
SITE_URL=

# Phase 2 Bitrix intake. SERVER ONLY: never prefix with NEXT_PUBLIC_, never log.
# Bitrix inbound webhook REST base URL, e.g. https://<portal>/rest/<user>/<code>/
# (the whole URL is a credential). Host must equal the configured portal domain.
BITRIX_WEBHOOK_BASE_URL=
# Outbound webhook verification token (auth[application_token]) from Bitrix.
BITRIX_EVENT_APPLICATION_TOKEN=
# Bearer secret for POST /api/integrations/bitrix/worker (32+ random characters).
INTAKE_WORKER_SECRET=
